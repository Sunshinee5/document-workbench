{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Document Workbench",
  "version": "0.1.0",
  "identifier": "com.documentworkbench.desktop",
  "build": {
    "beforeDevCommand": "pnpm --dir ../../ui dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --dir ../../ui build",
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "文档工作台",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "shortDescription": "本地绿色版文档工作台",
    "longDescription": "Windows 本地绿色版文档工作台，第一阶段提供 PDF 阅读编辑、Office 与 PDF 互转、OCR 能力。"
  }
}
